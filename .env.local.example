NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Invite codes — checked server-side only (in /api/supervisor-signup), never
# shipped to the browser. Whichever code is submitted determines the role, so
# keep them different and share each privately with only the right person.
SUPERVISOR_INVITE_CODE=your_supervisor_invite_code
DRPAUL_INVITE_CODE=your_drpaul_invite_code

# Firebase Admin SDK service-account credentials (server-only). Used by
# /api/supervisor-signup and scripts/create-supervisor.mjs to create accounts
# with elevated privileges, bypassing firestore.rules.
# Generate at: Firebase Console → Project Settings → Service Accounts →
# Generate new private key.
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
# Paste the private_key value from the downloaded JSON as-is (including the
# literal \n sequences) — quote it so the newlines survive as one env var.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
