rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSupervisor() {
      return isAuthed() && userDoc().role == 'supervisor';
    }

    function isLecturer() {
      return isAuthed() && userDoc().role == 'lecturer';
    }

    function isStaff() {
      return isAuthed() && userDoc().role in ['supervisor', 'lecturer'];
    }

    function isStudent() {
      return isAuthed() && userDoc().role == 'student';
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Fields only staff may set on a student's profile.
      function assignmentFields() {
        return ['assignedSupervisorUid', 'assignedSupervisorName'];
      }
      function deadlineFields() {
        return ['deadline', 'deadlineSetByName'];
      }

      // Profile photos are small data URLs; cap them well under the 1 MiB
      // document limit.
      function photoOk() {
        return !('photoURL' in request.resource.data)
          || (request.resource.data.photoURL is string
              && request.resource.data.photoURL.size() < 200000);
      }

      function isAssignedSupervisorOf() {
        return isSupervisor() && resource.data.assignedSupervisorUid == request.auth.uid;
      }

      // Everyone can read their own profile; the Lecturer can read any profile
      // (for the student roster). A Supervisor can read the profiles of the
      // students assigned to them — to see and set their deadlines.
      allow get: if isAuthed() && (request.auth.uid == userId || isLecturer() || isAssignedSupervisorOf());
      allow list: if isLecturer() || isAssignedSupervisorOf();

      // Clients may only self-register as a student, and can't pre-fill staff
      // fields. Supervisor and Lecturer accounts are created server-side (via
      // the Admin SDK, which bypasses these rules) after verifying an invite
      // code — see /api/supervisor-signup.
      allow create: if request.auth.uid == userId
        && request.resource.data.role == 'student'
        && !request.resource.data.keys().hasAny(assignmentFields().concat(deadlineFields()))
        && photoOk();

      // Users can update their own profile but cannot change their role,
      // self-assign a supervisor or move their own deadline. The Lecturer may
      // update the assignment and deadline fields on any profile; a
      // Supervisor only the deadline of a student assigned to them.
      allow update: if
        (request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['role'].concat(assignmentFields()).concat(deadlineFields()))
          && photoOk())
        || (isLecturer()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(assignmentFields().concat(deadlineFields())))
        || (isAssignedSupervisorOf()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(deadlineFields()));
    }

    // ── Cases ────────────────────────────────────────────────────────────────
    match /cases/{caseNumber} {
      // Students read their own case (matched via studentUid); staff read all
      // cases they're staff on — supervisors only the case they're assigned to.
      allow read: if isLecturer()
        || (isSupervisor() && resource.data.supervisorUid == request.auth.uid)
        || (isStudent() && resource.data.studentUid == request.auth.uid);

      // A student's case may only name the supervisor already assigned to them
      // by the Lecturer — they can't stamp an arbitrary supervisorUid at creation.
      function assignedSupervisorMatches() {
        return !('supervisorUid' in request.resource.data)
          || request.resource.data.supervisorUid == userDoc().assignedSupervisorUid;
      }

      // Students create a case — ownership proven by studentUid in the new document
      allow create: if isStudent()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.greenLight == false
        && !('customDeadline' in request.resource.data)
        && assignedSupervisorMatches();

      // Privileged fields that students can never modify. customDeadline is a
      // legacy student-set deadline; deadlines are now set by staff on the
      // student's profile, so it's frozen here.
      function protectedCaseFields() {
        return ['greenLight', 'supervisorApproval', 'lecturerApproval', 'supervisorUid', 'supervisorName', 'customDeadline'];
      }

      function studentCanUpdateCase() {
        let affected = request.resource.data.diff(resource.data).affectedKeys();
        // Students may submit their case (pending -> supervisor) but cannot change other stages,
        // and can never touch the protected fields above.
        return !affected.hasAny(protectedCaseFields())
          && (!affected.hasAny(['approvalStage'])
              || (resource.data.approvalStage == 'pending'
                  && request.resource.data.approvalStage == 'supervisor'));
      }

      allow update: if
        // Students can update their own case content and submit for review
        (isStudent()
          && resource.data.studentUid == request.auth.uid
          && studentCanUpdateCase())
        ||
        // The assigned supervisor can record their own approval and advance the stage
        (isSupervisor()
          && resource.data.supervisorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['approvalStage', 'supervisorApproval', 'updatedAt']))
        ||
        // The Lecturer can give/revoke final green light, record final approval,
        // and reassign a case to a different supervisor.
        (isLecturer()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['greenLight', 'approvalStage', 'lecturerApproval', 'supervisorUid', 'supervisorName', 'updatedAt']));
    }

    // ── Access Log ───────────────────────────────────────────────────────────
    match /accessLogs/{logId} {
      // Only the Lecturer can read the audit trail.
      allow read: if isLecturer();

      // Any authenticated user may write a log entry, but only one attributed
      // to themselves — they can't log an action as someone else. Entries are
      // append-only: no edits or deletes, so a log can't be altered after the
      // fact (though a user could still choose not to log — see the note in
      // lib/firestore.ts).
      allow create: if isAuthed() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
