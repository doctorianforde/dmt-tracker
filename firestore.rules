rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSupervisor() {
      return isAuthed() && userDoc().role == 'supervisor';
    }

    function isDrPaul() {
      return isAuthed() && userDoc().role == 'drpaul';
    }

    function isStaff() {
      return isAuthed() && userDoc().role in ['supervisor', 'drpaul'];
    }

    function isStudent() {
      return isAuthed() && userDoc().role == 'student';
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // All authenticated users can read user profiles so students can discover supervisors.
      // In a stricter deployment, expose supervisors through a dedicated public collection.
      allow read: if isAuthed();

      // Clients may only self-register as a student. Supervisor and Dr. Paul
      // accounts are created server-side (via the Admin SDK, which bypasses
      // these rules) after verifying an invite code — see /api/supervisor-signup.
      allow create: if request.auth.uid == userId
        && request.resource.data.role == 'student';

      // Users can update their own profile but cannot change their role
      allow update: if request.auth.uid == userId
        && !('role' in request.resource.data.diff(resource.data).affectedKeys());
    }

    // ── Cases ────────────────────────────────────────────────────────────────
    match /cases/{caseNumber} {
      // Students read their own case (matched via studentUid); staff read all
      allow read: if isStaff()
        || (isStudent() && resource.data.studentUid == request.auth.uid);

      // Students create a case — ownership proven by studentUid in the new document
      allow create: if isStudent()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.greenLight == false;

      // Privileged fields that students can never modify
      function protectedCaseFields() {
        return ['greenLight', 'supervisor1Approval', 'supervisor2Approval', 'drpaulApproval'];
      }

      function studentCanUpdateCase() {
        let affected = request.resource.data.diff(resource.data).affectedKeys();
        // Students may submit their case (pending -> supervisor1) but cannot change other stages,
        // and can never touch the protected fields above.
        return !affected.hasAny(protectedCaseFields())
          && (!affected.hasAny(['approvalStage'])
              || (resource.data.approvalStage == 'pending'
                  && request.resource.data.approvalStage == 'supervisor1'));
      }

      allow update: if
        // Students can update their own case content and submit for review
        (isStudent()
          && resource.data.studentUid == request.auth.uid
          && studentCanUpdateCase())
        ||
        // Supervisors can record their own approval and advance the stage
        (isSupervisor()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['approvalStage', 'supervisor1Approval', 'supervisor2Approval', 'updatedAt']))
        ||
        // Dr. Paul can give/revoke final green light and record final approval
        (isDrPaul()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['greenLight', 'approvalStage', 'drpaulApproval', 'updatedAt']));
    }
  }
}
