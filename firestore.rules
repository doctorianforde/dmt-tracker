rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    // Signed in AND has clicked the email confirmation link. Everything past
    // sign-in requires this; only reading/creating your own profile doesn't
    // (sign-up needs those before the email is confirmed).
    function isVerified() {
      return isAuthed() && request.auth.token.email_verified == true;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSupervisor() {
      return isVerified() && userDoc().role == 'supervisor';
    }

    function isLecturer() {
      return isVerified() && userDoc().role == 'lecturer';
    }

    function isStudent() {
      return isVerified() && userDoc().role == 'student';
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Fields only staff may set on a student's profile.
      function assignmentFields() {
        return ['supervisorDirectoryId', 'supervisorDirectoryName', 'assignedSupervisorUid', 'assignedSupervisorName'];
      }
      function deadlineFields() {
        return ['deadline', 'deadlineSetByName'];
      }

      // Profile photos are small data URLs; cap them well under the 1 MiB
      // document limit.
      function photoOk() {
        return !('photoURL' in request.resource.data)
          || (request.resource.data.photoURL is string
              && request.resource.data.photoURL.size() < 200000);
      }

      // A student may pick their own supervisor from the staff directory, but
      // only while their case is still a draft (not yet submitted).
      function caseIsDraft(caseNumber) {
        return !exists(/databases/$(database)/documents/cases/$(caseNumber))
          || get(/databases/$(database)/documents/cases/$(caseNumber)).data.get('approvalStage', 'pending') == 'pending';
      }
      function studentCanChangeSupervisor() {
        return resource.data.role == 'student'
          && (resource.data.get('caseNumber', '') == '' || caseIsDraft(resource.data.caseNumber));
      }

      // The pick must be a real directory entry, copied faithfully: its name,
      // plus its account uid/name only if that person has signed up.
      function staffChoiceMatches(d, entry) {
        return d.get('supervisorDirectoryName', null) == entry.name
          && d.get('assignedSupervisorUid', null) == entry.get('uid', null)
          && d.get('assignedSupervisorName', null) == ('uid' in entry ? entry.name : null);
      }

      function supervisorChoiceValid() {
        let d = request.resource.data;
        return !('supervisorDirectoryId' in d)
          ? !d.keys().hasAny(['supervisorDirectoryName', 'assignedSupervisorUid', 'assignedSupervisorName'])
          : staffChoiceMatches(d, get(/databases/$(database)/documents/staff/$(d.supervisorDirectoryId)).data);
      }

      function isAssignedSupervisorOf() {
        return isSupervisor() && resource.data.assignedSupervisorUid == request.auth.uid;
      }

      // Everyone can read their own profile; the Lecturer can read any profile
      // (for the student roster). A Supervisor can read the profiles of the
      // students assigned to them — to see and set their deadlines.
      allow get: if isAuthed() && (request.auth.uid == userId || isLecturer() || isAssignedSupervisorOf());
      allow list: if isLecturer() || isAssignedSupervisorOf();

      // Clients may only self-register as a student, and can't pre-fill staff
      // fields. Supervisor and Lecturer accounts are created server-side (via
      // the Admin SDK, which bypasses these rules) after verifying an invite
      // code — see /api/supervisor-signup.
      allow create: if request.auth.uid == userId
        && request.resource.data.role == 'student'
        && !request.resource.data.keys().hasAny(assignmentFields().concat(deadlineFields()))
        && photoOk();

      // A student works on one case at a time; caseNumber points at the
      // current one. It's locked while that case is in progress (the student
      // dashboard says so, and it keeps the supervisor pick locked after
      // submitting). Once the case has final approval the student may start a
      // new one — but only a case they have already created themselves.
      function caseApproved(n) {
        return exists(/databases/$(database)/documents/cases/$(n))
          && get(/databases/$(database)/documents/cases/$(n)).data.get('greenLight', false) == true;
      }
      function ownsCase(n) {
        return n is string
          && exists(/databases/$(database)/documents/cases/$(n))
          && get(/databases/$(database)/documents/cases/$(n)).data.studentUid == request.auth.uid;
      }
      function caseNumberLocked() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['caseNumber'])
          || ((resource.data.get('caseNumber', '') == '' || caseApproved(resource.data.caseNumber))
              && ownsCase(request.resource.data.get('caseNumber', null)));
      }

      // Users can update their own profile but cannot change their role or
      // move their own deadline; students may pick their supervisor (see
      // above). The Lecturer may update the assignment and deadline fields on
      // any profile; a Supervisor only the deadline of a student assigned to
      // them.
      allow update: if
        (request.auth.uid == userId
          && isVerified()
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['role'].concat(deadlineFields()))
          && caseNumberLocked()
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(assignmentFields())
              || (studentCanChangeSupervisor() && supervisorChoiceValid()))
          && photoOk())
        || (isLecturer()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(assignmentFields().concat(deadlineFields())))
        || (isAssignedSupervisorOf()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(deadlineFields()));
    }

    // ── Cases ────────────────────────────────────────────────────────────────
    match /cases/{caseNumber} {
      // Students read their own cases (matched via studentUid); the Lecturer
      // reads all; a supervisor reads the cases they're assigned to.
      // A supervisor also reads the earlier cases of students currently
      // assigned to them (to see how many they've had approved).
      allow read: if isLecturer()
        || (isSupervisor() && resource.data.supervisorUid == request.auth.uid)
        || (isSupervisor()
            && get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.get('assignedSupervisorUid', null) == request.auth.uid)
        || (isStudent() && resource.data.studentUid == request.auth.uid);

      // A student's case may only name the supervisor already assigned to them
      // by the Lecturer — they can't stamp an arbitrary supervisorUid at creation.
      function assignedSupervisorMatches() {
        return !('supervisorUid' in request.resource.data)
          || request.resource.data.supervisorUid == userDoc().assignedSupervisorUid;
      }

      // Students create a case — ownership proven by studentUid in the new
      // document. A new case starts as a draft with no approvals recorded, and
      // its caseNumber field must match the document id.
      allow create: if isStudent()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.caseNumber == caseNumber
        && request.resource.data.greenLight == false
        && request.resource.data.get('approvalStage', 'pending') == 'pending'
        && !request.resource.data.keys().hasAny(['customDeadline', 'supervisorApproval', 'lecturerApproval'])
        && assignedSupervisorMatches();

      // Fields that students can never modify. customDeadline is a legacy
      // student-set deadline; deadlines are now set by staff on the student's
      // profile, so it's frozen here. studentUid identifies the case's owner.
      function protectedCaseFields() {
        return ['greenLight', 'supervisorApproval', 'lecturerApproval', 'customDeadline', 'studentUid'];
      }

      // Supervisor review happens only at the 'supervisor' stage: approving
      // moves the case on to the Lecturer; rejecting keeps it where it is.
      function supervisorReviewOk() {
        let before = resource.data.get('approvalStage', 'pending');
        let after = request.resource.data.get('approvalStage', 'pending');
        let approved = request.resource.data.get('supervisorApproval', {}).get('approved', false);
        return before == 'supervisor'
          && ((after == 'lecturer' && approved == true)
              || (after == 'supervisor' && approved == false));
      }

      // The green light only ever accompanies a finished review. (Cases from
      // before approvalStage existed have no stage; they're left alone.)
      function greenLightConsistent() {
        return request.resource.data.greenLight != true
          || request.resource.data.get('approvalStage', 'approved') == 'approved';
      }

      // Students may copy their own profile's supervisor onto their case,
      // only while it's still a draft.
      function studentSupervisorSyncOk() {
        let affected = request.resource.data.diff(resource.data).affectedKeys();
        return !affected.hasAny(['supervisorUid', 'supervisorName'])
          || (resource.data.get('approvalStage', 'pending') == 'pending'
              && request.resource.data.get('supervisorUid', null) == userDoc().get('assignedSupervisorUid', null)
              && request.resource.data.get('supervisorName', null) == userDoc().get('assignedSupervisorName', null));
      }

      function studentCanUpdateCase() {
        let affected = request.resource.data.diff(resource.data).affectedKeys();
        // Students may submit their case (pending -> supervisor) but cannot change other stages,
        // and can never touch the protected fields above.
        return !affected.hasAny(protectedCaseFields())
          && request.resource.data.get('caseNumber', caseNumber) == caseNumber
          && studentSupervisorSyncOk()
          && (!affected.hasAny(['approvalStage'])
              || (resource.data.approvalStage == 'pending'
                  && request.resource.data.approvalStage == 'supervisor'));
      }

      allow update: if
        // Students can update their own case content and submit for review
        (isStudent()
          && resource.data.studentUid == request.auth.uid
          && studentCanUpdateCase())
        ||
        // The assigned supervisor can record their own approval and advance the stage
        (isSupervisor()
          && resource.data.supervisorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['approvalStage', 'supervisorApproval', 'updatedAt'])
          && supervisorReviewOk())
        ||
        // The Lecturer can give/revoke final green light, record final approval,
        // reassign a case to a different supervisor, and — when a student has
        // picked them as their supervisor — record the supervisor approval.
        (isLecturer()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['greenLight', 'approvalStage', 'lecturerApproval', 'supervisorApproval', 'supervisorUid', 'supervisorName', 'updatedAt'])
          && greenLightConsistent());
    }

    // ── Staff directory ──────────────────────────────────────────────────────
    match /staff/{entryId} {
      // Any signed-in user can see the directory (students pick their
      // supervisor from it). Only the server writes to it: entries are seeded
      // by scripts/seed-staff-directory.mjs and claimed at staff sign-up.
      allow read: if isVerified();
      allow write: if false;
    }

    // ── Access Log ───────────────────────────────────────────────────────────
    match /accessLogs/{logId} {
      // Only the Lecturer can read the audit trail.
      allow read: if isLecturer();

      // Any authenticated user may write a log entry, but only one attributed
      // to themselves — they can't log an action as someone else. Entries are
      // append-only: no edits or deletes, so a log can't be altered after the
      // fact (though a user could still choose not to log — see the note in
      // lib/firestore.ts).
      // The role and timestamp must be genuine too, so an entry can't claim to
      // come from a Lecturer or be backdated.
      allow create: if isAuthed()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorRole == userDoc().role
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
