rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSupervisor() {
      return isAuthed() && userDoc().role == 'supervisor';
    }

    function isDrPaul() {
      return isAuthed() && userDoc().role == 'drpaul';
    }

    function isStaff() {
      return isAuthed() && userDoc().role in ['supervisor', 'drpaul'];
    }

    function isStudent() {
      return isAuthed() && userDoc().role == 'student';
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isStaff();

      allow create: if request.auth.uid == userId
        && request.resource.data.role in ['student', 'supervisor', 'drpaul'];

      // Users can update their own profile but cannot change their role
      allow update: if request.auth.uid == userId
        && !('role' in request.resource.data.diff(resource.data).affectedKeys());
    }

    // ── Cases ────────────────────────────────────────────────────────────────
    match /cases/{caseNumber} {
      // Students read their own case (matched via studentUid); staff read all
      allow read: if isStaff()
        || (isStudent() && resource.data.studentUid == request.auth.uid);

      // Students create a case — ownership proven by studentUid in the new document
      allow create: if isStudent()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.greenLight == false;

      // Privileged fields that students can never modify
      function protectedCaseFields() {
        return ['greenLight', 'approvalStage', 'submitted',
                'supervisor1Approval', 'supervisor2Approval', 'drpaulApproval'];
      }

      allow update: if
        // Students can update their own case content but cannot touch approval state
        (isStudent()
          && resource.data.studentUid == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedCaseFields()))
        ||
        // Supervisors can record their own approval and advance the stage
        (isSupervisor()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['approvalStage', 'supervisor1Approval', 'supervisor2Approval', 'updatedAt']))
        ||
        // Dr. Paul can give/revoke final green light and record final approval
        (isDrPaul()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['greenLight', 'approvalStage', 'drpaulApproval', 'updatedAt']));
    }
  }
}
